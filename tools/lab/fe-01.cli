# fe-01 · lab build 2 (2026-11-22) · vIST peer of fe-02 · see tools/lab/README.md
# [new] = never accepted by these switches yet; every other line was, in an earlier round.
enable
configure terminal

# ---- 1. base: your Ansible already does this, plus the vIST lines before IS-IS is enabled ----
prompt "fe-01"
spbm
spbm ethertype 0x8100
vlan create 4051 name "bvlan-1" type spbm-bvlan
vlan create 4052 name "bvlan-2" type spbm-bvlan
interface loopback 1
ip address 1 10.255.0.1/255.255.255.255
exit
router isis
spbm 1
spbm 1 nick-name 0.00.11
spbm 1 b-vid 4051-4052 primary 4051
spbm 1 ip enable
spbm 1 smlt-peer-system-id <fe-02's system ID>
spbm 1 smlt-virtual-bmac 02:00:00:00:12:00
is-type l1
manual-area 49.0001
ip-source-address 10.255.0.1
exit
# smlt-peer-system-id: fe-02's ID as `show isis system-id` prints it (HOME). It changes with
# every new VM; a fixed `system-id` did not take in build 2.
interface gigabitEthernet 1/1-1/3
encapsulation dot1q
isis
isis spbm 1
isis enable
no spanning-tree mstp force-port-state enable
exit
# vIST with fe-02, over the fabric: VLAN 4000 and the peer-ip before IS-IS is enabled
vlan create 4000 name "vist" type port-mstprstp 0
vlan i-sid 4000 40000
interface vlan 4000
ip address 192.168.255.1 255.255.255.252
exit
virtual-ist peer-ip 192.168.255.2 vlan 4000
router isis enable
# STOP: `router isis enable` asks "(y/n)" (a warning about the default system-id and a generated
# virtual B-MAC); answer y by hand, a pasted line would be eaten. The vIST peer-ip has to be set
# before IS-IS is enabled ("Virtual IST requires both SPBM SMLT peer system-id & Virtual IST
# peer-ip"). Paste everything above this line, answer y, then paste the rest.

# ---- 2. global routes over IP shortcuts ----
router isis
redistribute direct
redistribute direct enable
exit
isis apply redistribute direct

# ---- 3. VLAN 40 on 1/4, L2 VSN with fe-02 ----
interface gigabitEthernet 1/4
no auto-sense enable
exit
vlan create 40 name "servers" type port-mstprstp 0
vlan members add 40 1/4
vlan i-sid 40 20040

# ---- 4. SMLT 20 to fe-03, LACP, trunk with VLAN 60: encapsulation first, LACP last ----
vlan create 60 name "smlt-test" type port-mstprstp 0
vlan i-sid 60 20060
mlt 20 enable name "smlt-fe03"
mlt 20 encapsulation dot1q
interface mlt 20
smlt
lacp enable key 20
exit
# `lacp smlt-sys-id` is not valid under `interface mlt` (build 2). If fe-03's MLT 20 forms over
# only one link, try `lacp smlt-sys-id 02:00:00:00:20:00` in global config (untested).
interface gigabitEthernet 1/5
no auto-sense enable
encapsulation dot1q
lacp key 20 aggregation enable timeout-time short
lacp enable
no shutdown
exit
vlan mlt 60 20

# ---- 5. MLT 10 to fe-02, LACP trunk with VLAN 50 (not in the fabric) ----
vlan create 50 name "lacp-test" type port-mstprstp 0
mlt 10 enable name "lacp-to-peer"
mlt 10 encapsulation dot1q
interface mlt 10
lacp enable key 10
exit
interface gigabitEthernet 1/6-1/7
no auto-sense enable
encapsulation dot1q
lacp key 10 aggregation enable timeout-time short
lacp enable
no shutdown
exit
vlan mlt 50 10

# ---- 6. ELAN I-SID 30100: Switched UNI on ports without a cable ----
interface gigabitEthernet 1/8-1/9
no auto-sense enable
encapsulation dot1q
flex-uni enable
exit
i-sid 30100 elan
c-vid 100 port 1/8
untagged-traffic port 1/9
exit

# ---- 7. long lists: VLAN 70's member list wraps, 1/12's VLAN list overflows ----
interface gigabitEthernet 1/12-1/24
no auto-sense enable
exit
interface gigabitEthernet 1/12
encapsulation dot1q
exit
vlan create 70 name "wrap-test" type port-mstprstp 0
vlan members add 70 1/12,1/14,1/16,1/18,1/20,1/22,1/24
vlan create 71 type port-mstprstp 0
vlan create 72 type port-mstprstp 0
vlan create 73 type port-mstprstp 0
vlan create 74 type port-mstprstp 0
vlan create 75 type port-mstprstp 0
vlan create 76 type port-mstprstp 0
vlan create 77 type port-mstprstp 0
vlan create 78 type port-mstprstp 0
vlan members add 71 1/12
vlan members add 72 1/12
vlan members add 73 1/12
vlan members add 74 1/12
vlan members add 75 1/12
vlan members add 76 1/12
vlan members add 77 1/12
vlan members add 78 1/12

# ---- 8. last: LACP on globally (without it no port runs LACP) ----
lacp enable
end
