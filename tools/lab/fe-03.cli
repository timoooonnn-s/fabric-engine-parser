# fe-03 · lab build 2 (2026-11-22) · SMLT client of fe-01/fe-02, VRF blue · see tools/lab/README.md
# [new] = never accepted by these switches yet; every other line was, in an earlier round.
enable
configure terminal

# ---- 1. base: your Ansible already does this ----
prompt "fe-03"
spbm
spbm ethertype 0x8100
vlan create 4051 name "bvlan-1" type spbm-bvlan
vlan create 4052 name "bvlan-2" type spbm-bvlan
interface loopback 1
ip address 1 10.255.0.3/255.255.255.255
exit
router isis
spbm 1
spbm 1 nick-name 0.00.13
spbm 1 b-vid 4051-4052 primary 4051
spbm 1 ip enable
is-type l1
manual-area 49.0001
ip-source-address 10.255.0.3
exit
interface gigabitEthernet 1/1-1/2
encapsulation dot1q
isis
isis spbm 1
isis enable
no spanning-tree mstp force-port-state enable
exit
router isis enable

# ---- 2. global routes over IP shortcuts ----
router isis
redistribute direct
redistribute direct enable
exit
isis apply redistribute direct

# ---- 3. VLANs 10, 20, 30 on 1/3-1/5, L2 VSNs (10 and 20 with fe-04) ----
interface gigabitEthernet 1/3-1/5
no auto-sense enable
exit
vlan create 10 name "users" type port-mstprstp 0
vlan members add 10 1/3
vlan i-sid 10 20010
vlan create 20 name "voice" type port-mstprstp 0
vlan members add 20 1/4
vlan i-sid 20 20020
vlan create 30 name "printers" type port-mstprstp 0
vlan members add 30 1/5
vlan i-sid 30 20030

# ---- 4. gateway for VLAN 10 and a static route, in the GlobalRouter ----
interface vlan 10
ip address 10.10.10.3 255.255.255.0
exit
ip route 192.0.2.0 255.255.255.0 10.10.10.13 weight 10

# ---- 5. VRF blue with an L3 VSN ----
ip vrf blue vrfid 1
router vrf blue
ipvpn
i-sid 30001
ipvpn enable
isis redistribute direct
isis redistribute direct enable
exit
isis apply redistribute direct vrf blue

# ---- 6. MLT 20 to fe-01 1/5 and fe-02 1/5 (their SMLT), LACP trunk ----
# VLAN 60 has no I-SID here: fe-01 and fe-02 carry it in the fabric; mapping it here too
# would close a loop through the fabric.
vlan create 60 name "smlt-test" type port-mstprstp 0
mlt 20 enable name "uplink-fe01-fe02"
mlt 20 encapsulation dot1q
interface mlt 20
lacp enable key 20
exit
interface gigabitEthernet 1/6-1/7
no auto-sense enable
encapsulation dot1q
lacp key 20 aggregation enable timeout-time short
lacp enable
no shutdown
exit
vlan mlt 60 20

# ---- 7. VLAN 103 in VRF blue, on MLT 20 so its interface comes up without a free port ----
vlan create 103 name "blue-3" type port-mstprstp 0
vlan mlt 103 20
interface vlan 103
vrf blue
ip address 10.100.3.1 255.255.255.0
exit

# ---- 8. last: LACP on globally ----
lacp enable
end
